# Claude API key (https://console.anthropic.com). Without it Huntloop runs in demo mode with simulated AI responses.
ANTHROPIC_API_KEY=

# Optional: force simulated AI responses even when a key is present ("fake"), or real calls ("live").
# HUNTLOOP_AI=live

# Optional: initial default model for every AI task (changeable later in Settings → AI models).
# HUNTLOOP_DEFAULT_MODEL=claude-opus-5-5

# Optional: where the database, uploads and browser profile live (default: ./data).
# HUNTLOOP_DATA_DIR=./data

# Job search sources (Phase 3)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JSEARCH_API_KEY=

# SEEK / LinkedIn (Settings → Job sources) use your installed Google Chrome in a visible window.
# Point this at another Chrome or Chromium executable if needed.
# HUNTLOOP_BROWSER_PATH=
