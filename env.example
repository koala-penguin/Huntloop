# Claude API key (https://console.anthropic.com), for the "API key" connection. Not needed if you use your Claude
# subscription instead (Settings → Claude connection: sign in to Claude Code with `claude auth login`).
# Without an API key the API connection runs in demo mode with simulated AI responses. A subscription connection
# whose Claude Code isn't signed in pauses AI work instead (no simulated answers).
ANTHROPIC_API_KEY=

# Optional: force simulated AI responses ("fake"), or assume the API key ("live") / Claude Code ("claude-code") works.
# HUNTLOOP_AI=live

# Optional, subscription connection: path to the Claude Code CLI (default: `claude` on PATH), and the address the CLI
# uses to reach Huntloop's tool endpoint (default: http://127.0.0.1:$PORT).
# HUNTLOOP_CLAUDE_PATH=
# HUNTLOOP_ORIGIN=http://127.0.0.1:3000

# Optional: other host names the app answers for (comma-separated host[:port]; without a port, any port). Requests for
# any other Host get 421, which stops DNS-rebinding pages. localhost / 127.0.0.1 / [::1] and the host of
# HUNTLOOP_ORIGIN are always allowed, so set HUNTLOOP_ORIGIN to the address you open the app at from other devices.
# HUNTLOOP_ALLOWED_HOSTS=my-mac.tailnet-name.ts.net:3000

# Optional: initial default model for every AI task (changeable later in Settings → AI models).
# HUNTLOOP_DEFAULT_MODEL=claude-opus-5-5

# Optional: where the database, uploads and browser profile live (default: ./data).
# HUNTLOOP_DATA_DIR=./data

# Job search sources (Phase 3)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# SEEK / LinkedIn (Settings → Job sources) use your installed Google Chrome in a visible window.
# Point this at another Chrome or Chromium executable if needed.
# HUNTLOOP_BROWSER_PATH=

# Optional: Discord webhook that gets a message (with screenshot) when a SEEK/LinkedIn/browsing run pauses on a
# CAPTCHA, sign-in wall or checkpoint. Events are also saved under data/captcha-events/.
# HUNTLOOP_DISCORD_WEBHOOK=
